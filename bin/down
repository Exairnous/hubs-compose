#!/bin/bash
basedir=$(dirname "$0")/..
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    IP_ADDR=$(hostname -i | cut -f1 -d " ")
elif [[ "$OSTYPE" == "darwin"* ]]; then
    IP_ADDR=$(ip route get 1 | awk '{print $NF;exit}')
fi
PRIVATE_NETWORK_IP=${IP_ADDR} mutagen-compose -f "$basedir"/docker-compose.yml down
