#!/bin/bash
basedir=$(dirname "$0")/..

prefix='\n\033[1;37m'
suffix='\033[0m\n'
echo -e ${prefix}Starting mutagen daemon...$suffix
mutagen daemon start
echo -e ${prefix}The mutagen daemon will stay running until you stop it manually with \`mutagen daemon stop\`.$suffix

echo -e ${prefix}Running mutagen-compose...$suffix

if [[ "$OSTYPE" == "linux-gnu"* ]]; then
    currentnetworkinterface=$(ip addr show | awk '/inet.*brd/{print $NF}' | grep -E -v "(br-*)|(docker)")
    IP_ADDR=$(ip addr show $currentnetworkinterface | while read IPADDRESSTYPE IPADDRESS ETC; do [ "$IPADDRESSTYPE" == "inet" ] && echo $IPADDRESS | cut -d "/" -f1; done)
elif [[ "$OSTYPE" == "darwin"* ]]; then
    IP_ADDR=$(ip route get 1 | awk '{print $NF;exit}')
fi
IP_ADDR=$(ip route get 1 | grep -o "src.*uid" | cut -d " " -f2)
echo ${IP_ADDR}
PRIVATE_NETWORK_IP=${IP_ADDR} mutagen-compose -f "$basedir"/docker-compose.yml up --build --detach
